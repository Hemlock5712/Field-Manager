# Host NIC connected to a tagged VLAN trunk on the 5420M.
FM_PARENT_INTERFACE=eth0
FM_MANAGEMENT_VLAN=100
FM_MANAGEMENT_ADDRESS=10.0.100.5/24
# Optional secondary address when an AP uses a different management subnet.
# The VH-113 Practice profile at 10.0.100.1 is already reachable through
# FM_MANAGEMENT_ADDRESS, so this remains empty for the supplied field plan.
FM_AP_MANAGEMENT_ADDRESS=
FM_ONBOARDING_VLAN=999
FM_ONBOARDING_ADDRESS=10.99.0.1/24
FM_ONBOARDING_SUBNET=10.99.0.0/24
FM_ONBOARDING_PORTAL_URL=http://10.99.0.1/portal

# Fabric Engine/VOSS SSH endpoint, pinned host key, and application-owned ports.
FM_SWITCH_OS=fabric-engine
FM_SWITCH_URL=ssh://10.0.100.2
FM_SWITCH_USER=field-manager
# Capture this once from a trusted console/management path; see the setup guide.
FM_SWITCH_SSH_HOST_KEY_SHA256=SHA256:replace-with-the-switch-host-key
# Required only for VOSS 8.4.0; remove or set false after upgrading the switch.
FM_SWITCH_ALLOW_LEGACY_SSH_KEX=true
# Leave empty to use the Fabric Engine standalone 1/1-1/52 default.
FM_SWITCH_PORT_IDS=
FM_SWITCH_CLIENT_PORTS=1/1,1/2,1/3,1/4,1/5,1/6,1/7,1/8,1/9,1/10,1/11,1/12
FM_SWITCH_AP_TRUNK_PORTS=1/48
FM_SWITCH_SERVER_PORTS=1/47
FM_SWITCH_MANAGEMENT_PORTS=1/46
FM_SWITCH_UNUSED_PORTS=1/13,1/14,1/15,1/16,1/17,1/18,1/19,1/20,1/21,1/22,1/23,1/24,1/25,1/26,1/27,1/28,1/29,1/30,1/31,1/32,1/33,1/34,1/35,1/36,1/37,1/38,1/39,1/40,1/41,1/42,1/43,1/44,1/45,1/49,1/50,1/51,1/52
FM_SWITCH_SAVE_CONFIGURATION=true

# frc-radio-api endpoint on the physical VH-113 running the Practice profile.
FM_AP_URL=http://10.0.100.1:8081
FM_AP_CHANNEL=157
FM_AP_CHANNEL_BANDWIDTH=20MHz

# Used only with compose.ghcr.yaml. A v1.2.3 release publishes tag 1.2.3.
FM_IMAGE_REGISTRY=ghcr.io/hemlock5712
FM_IMAGE_TAG=replace-with-release-or-sha-tag
